# Measured profile for the real 24^3x64 file with csw=1.160920226.
# Use the NUMA launcher with --ranks-per-numa 2 --threads 16 on node5005.
# Pass --solver-options profiles/epyc9755_physical_solver.json after setup.
# Mass/csw/stout remain explicit CLI inputs.
unset LQCD_MG_SAP_CYCLES LQCD_MG_SAP_STEPS LQCD_MG_COARSE_IT LQCD_MG_COARSE_TOL LQCD_CORRECTION_BASE_TOL
export LQCD_MG_SETUP_PASSES=2
export LQCD_MG_SETUP_ITERATIONS=3
export LQCD_MG_SETUP_SMOOTH=12
export LQCD_FLOAT_CORRECTION_VERIFY=0
export LQCD_FINE_TEAM_FUSED=1
export LQCD_LOCAL_CONTIGUOUS=1
export LQCD_COARSE_CGS2=0
export LQCD_RESTRICT_FLOAT=0
export LQCD_GCR_FUSED=1
export LQCD_SAP_EO=1
export LQCD_COARSE_EO=1
export LQCD_SETUP_UPDATE=inverse
export LQCD_ADAPTIVE_CORRECTION=1
export LQCD_HALO_OVERLAP=1
export LQCD_RHS_BATCH=2
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1

cmake_minimum_required(VERSION 3.16)
project(openqcd_bench C)
find_package(MPI REQUIRED COMPONENTS C)
find_package(OpenMP REQUIRED COMPONENTS C)
file(GLOB_RECURSE SOURCES "${OPENQCD_ROOT}/modules/*.c")
list(FILTER SOURCES EXCLUDE REGEX "/nompi/")
add_library(openqcd STATIC ${SOURCES})
target_include_directories(openqcd PUBLIC "${OPENQCD_ROOT}/include")
target_compile_options(openqcd PRIVATE -O3 -mfpmath=sse -mno-avx)
target_compile_definitions(openqcd PUBLIC AVX FMA3 PM)
target_link_libraries(openqcd PUBLIC MPI::MPI_C OpenMP::OpenMP_C m)
add_executable(openqcd_bench "${DRIVER_ROOT}/openqcd_bench.c")
target_link_libraries(openqcd_bench PRIVATE openqcd)

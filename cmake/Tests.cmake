    if(LQCD_BUILD_RUNTIME AND LQCD_TEST_PYTHON)
        add_executable(native_allocator_test tests/unit/native_allocator_test.cpp)
        add_test(NAME native_allocator COMMAND native_allocator_test)
        get_filename_component(LQCD_MPI_BIN "${MPI_C_COMPILER}" DIRECTORY)
        execute_process(COMMAND "${LQCD_MPI_BIN}/mpiexec" --version
            OUTPUT_VARIABLE LQCD_TEST_MPI_VERSION ERROR_QUIET)
        set(LQCD_TEST_MPI_DEFAULT_FLAGS "")
        if(LQCD_TEST_MPI_VERSION MATCHES "Open MPI|OpenRTE|PRRTE")
            set(LQCD_TEST_MPI_DEFAULT_FLAGS --bind-to none)
        endif()
        set(LQCD_MPI_FLAGS "${LQCD_TEST_MPI_DEFAULT_FLAGS}" CACHE STRING
            "MPI launcher flags for hybrid tests")
        set(LQCD_RUNTIME_ENV
            "LQCD_CPU_LIBRARY=$<TARGET_FILE:lqcd_cpu>;OMP_NUM_THREADS=2;OPENBLAS_NUM_THREADS=1;OMPI_MCA_hwloc_base_binding_policy=none")
        add_test(NAME cpu_backend_serial COMMAND "${LQCD_TEST_PYTHON}" "${CMAKE_CURRENT_SOURCE_DIR}/tests/runtime/test_cpu_backend.py")
        add_test(NAME cpu_backend_mpi2 COMMAND "${LQCD_MPI_BIN}/mpiexec" ${LQCD_MPI_FLAGS} -n 2 "${LQCD_TEST_PYTHON}" "${CMAKE_CURRENT_SOURCE_DIR}/tests/runtime/test_cpu_backend.py")
        set_tests_properties(cpu_backend_serial cpu_backend_mpi2 PROPERTIES TIMEOUT 240 ENVIRONMENT "${LQCD_RUNTIME_ENV}")
        # A singleton test must not inherit a build job's spread policy over
        # hundreds of NUMA places. Keep its two OpenMP workers close without
        # hardcoding host CPU numbers or extending the numerical timeout.
        set_tests_properties(cpu_backend_serial PROPERTIES ENVIRONMENT
            "${LQCD_RUNTIME_ENV};OMP_PLACES=cores;OMP_PROC_BIND=close")

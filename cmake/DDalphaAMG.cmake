# Build a private PIC archive; do not mutate the user's existing reference build.
set(LQCD_DDALPHAAMG_SOURCE "" CACHE PATH "DDalphaAMG source tree (pinned ETMC CPU branch)")
if(NOT EXISTS "${LQCD_DDALPHAAMG_SOURCE}/src/DDalphaAMG.h")
  message(FATAL_ERROR "Set LQCD_DDALPHAAMG_SOURCE to the ETMC CPU source tree")
endif()
find_program(LQCD_MAKE NAMES gmake make REQUIRED)
set(DD_WORK "${CMAKE_CURRENT_BINARY_DIR}/deps/ddalphaamg")
file(MAKE_DIRECTORY "${DD_WORK}/build/gsrc" "${DD_WORK}/include" "${DD_WORK}/lib")
file(COPY "${LQCD_DDALPHAAMG_SOURCE}/src" DESTINATION "${DD_WORK}")
foreach(file Makefile float.sed double.sed COPYING)
  configure_file("${LQCD_DDALPHAAMG_SOURCE}/${file}" "${DD_WORK}/${file}" COPYONLY)
endforeach()
file(READ "${DD_WORK}/src/clifford.h" DD_CLIFFORD)
string(REPLACE "#define BASIS4 // change here" "#define BASIS0 // CPU API uses the documented BASIS0" DD_CLIFFORD "${DD_CLIFFORD}")
file(WRITE "${DD_WORK}/src/clifford.h" "${DD_CLIFFORD}")
if(NOT DD_CLIFFORD MATCHES "#define BASIS0")
  message(FATAL_ERROR "DDalphaAMG must be configured with BASIS0 for this adapter")
endif()
set(DD_FLAGS "-std=gnu99 -O3 -fPIC -fopenmp -fcommon -Wno-error=implicit-function-declaration")
set(LQCD_DD_SIMD "SSE" CACHE STRING "DDalphaAMG kernel set: SSE or GENERIC")
set_property(CACHE LQCD_DD_SIMD PROPERTY STRINGS SSE GENERIC)
if(LQCD_DD_SIMD STREQUAL "SSE")
  if(NOT CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64|i.86")
    message(FATAL_ERROR "SSE kernel set requires x86; use GENERIC for an initial non-x86 port")
  endif()
  string(APPEND DD_FLAGS " -msse4.2")
  set(DD_SIMD_FLAGS "-DSSE")
elseif(NOT LQCD_DD_SIMD STREQUAL "GENERIC")
  message(FATAL_ERROR "Unknown LQCD_DD_SIMD=${LQCD_DD_SIMD}")
endif()
set(LQCD_CPU_NATIVE ON CACHE BOOL "Tune DDalphaAMG for this build CPU")
if(LQCD_CPU_NATIVE)
  string(APPEND DD_FLAGS " -march=native")
endif()
file(GLOB DD_DEPENDS "${DD_WORK}/src/*")
add_custom_command(OUTPUT "${DD_WORK}/lib/libDDalphaAMG.a" "${DD_WORK}/include/DDalphaAMG.h"
  COMMAND ${LQCD_MAKE} -C "${DD_WORK}" -j8 lib/libDDalphaAMG.a include/DDalphaAMG.h
    "CC=${MPI_C_COMPILER}" "CFLAGS=${DD_FLAGS}" LIMEFLAGS= LIMELIB=
    "OPT_VERSION_FLAGS=${DD_FLAGS} -DOPENMP -DPARAMOUTPUT -DTRACK_RES ${DD_SIMD_FLAGS}"
  DEPENDS ${DD_DEPENDS} "${DD_WORK}/Makefile" VERBATIM)
add_custom_target(ddalphaamg_archive DEPENDS "${DD_WORK}/lib/libDDalphaAMG.a" "${DD_WORK}/include/DDalphaAMG.h")
add_library(ddalphaamg STATIC IMPORTED GLOBAL)
set_target_properties(ddalphaamg PROPERTIES IMPORTED_LOCATION "${DD_WORK}/lib/libDDalphaAMG.a"
  INTERFACE_INCLUDE_DIRECTORIES "${DD_WORK}/include")
add_dependencies(ddalphaamg ddalphaamg_archive)
